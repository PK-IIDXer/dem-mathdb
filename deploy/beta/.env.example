# Server-local values only. install.sh generates passwords; never commit .env.
DEM_BETA_DOMAIN=<beta.example.invalid>
DEM_BETA_HOME=<absolute-runtime-directory>
DEM_BETA_ADMIN_PASSWORD=<generated-hex-password>
DEM_BETA_OWNER_PASSWORD=<generated-hex-password>
DEM_BETA_APP_PASSWORD=<generated-hex-password>
DEM_BETA_COMMIT=<full-public-commit-sha>
DEM_BETA_RESET_SCHEDULE='<weekday HH:MM IANA-timezone>'
DEM_BETA_NOINDEX=<1-or-0>
DEM_BETA_INTERFACE=<outbound-interface>
DEM_BETA_MONTHLY_TX_LIMIT=<bytes-default-2500000000000>
# Host only; never pass this value to a container or print it.
DEM_BETA_SLACK_WEBHOOK_URL=<slack-incoming-webhook-url>
DEM_BETA_DB_VOLUME=<docker-volume-name-default-dem-beta_pgdata>
